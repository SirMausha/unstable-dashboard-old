# Shared
UMA_API_KEY=uma_k_replace_me

# Local SQLite workspace (npm run dev)
PORT=4174
DATABASE_PATH=./data/dashboard.sqlite

# Optional: publish sanitized input through the GitHub Contents API (local publish flow)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PUBLIC_INPUT_PATH=public-data/input.json

# Vercel / online app (also set these in the Vercel project env)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=generate-a-long-random-string
SITE_URL=http://127.0.0.1:4174

# Discord channel webhook for new applications (Server Settings → Integrations → Webhooks)
DISCORD_APPLY_WEBHOOK_URL=

# Do NOT set VITE_LOCAL_WORKSPACE on Vercel. That flag is only for `npm run dev`.
