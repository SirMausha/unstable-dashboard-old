{
  "name": "uma-club-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --mode workspace",
    "dev:server": "tsx watch server/index.ts",
    "dev:online": "vercel dev",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:vercel": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "oxlint src server scripts api",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:public": "tsx scripts/sync-public.ts",
    "backup": "tsx scripts/backup.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^13.0.2",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint-plugin-security": "^4.0.1",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
